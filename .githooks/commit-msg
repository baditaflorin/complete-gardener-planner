#!/usr/bin/env bash
set -euo pipefail

message_file="$1"
first_line="$(head -n 1 "$message_file")"

if [[ ! "$first_line" =~ ^(feat|fix|docs|chore|refactor|test|ops|data|security)(\([a-zA-Z0-9_-]+\))?:\ .+ ]]; then
  echo "Commit message must follow Conventional Commits, e.g. feat: add planner"
  exit 1
fi
